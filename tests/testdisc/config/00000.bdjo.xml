<?xml version="1.0" encoding="UTF-8"?>
<!--
  BDJO configuration for HAVI Test Xlet
  Uses HD Cookbook XML format (subset - unsupported features will error)
  
  Supported features:
    - Single application per BDJO
    - JAR cache entries (type=1)
    - Basic terminal info (resolution, menu/title masks)
    - Access to all playlists
    
  Unsupported (will error if present):
    - Multiple applications
    - Directory cache entries (type=2)
    - App names, parameters, icons
    - Mouse support, 3D output mode, frame rate hints
    - Explicit playlist file names
-->
<bdjo>
    <version>V_0200</version>
    
    <terminalInfo>
        <defaultFontFile>*****</defaultFontFile>
        <initialHaviConfig>HD_1920_1080</initialHaviConfig>
        <menuCallMask>false</menuCallMask>
        <titleSearchMask>false</titleSearchMask>
    </terminalInfo>
    
    <appCacheInfo>
        <entries>
            <type>1</type>
            <name>00000</name>
            <language>*.*</language>
        </entries>
    </appCacheInfo>
    
    <applicationManagementTable>
        <applications>
            <controlCode>1</controlCode>
            <organizationId>0x7fff0001</organizationId>
            <applicationId>0x4000</applicationId>
            <type>0x1</type>
            <applicationDescriptor>
                <priority>128</priority>
                <binding>TITLE_BOUND_DISC_BOUND</binding>
                <visibility>V_11</visibility>
                <initialClassName>org.videolan.test.HaviTestXlet</initialClassName>
                <baseDirectory>00000</baseDirectory>
                <classpathExtension></classpathExtension>
                <profiles>
                    <profile>1</profile>
                    <majorVersion>1</majorVersion>
                    <minorVersion>0</minorVersion>
                    <microVersion>0</microVersion>
                </profiles>
            </applicationDescriptor>
        </applications>
    </applicationManagementTable>
    
    <tableOfAccessiblePlayLists>
        <accessToAllFlag>true</accessToAllFlag>
        <autostartFirstPlayListFlag>false</autostartFirstPlayListFlag>
    </tableOfAccessiblePlayLists>
    
    <keyInterestTable>0xffe00000</keyInterestTable>
    <fileAccessInfo>.</fileAccessInfo>
</bdjo>
